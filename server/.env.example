# Server
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT cookie duration (days) — Supabase session stored in httpOnly cookie
JWT_COOKIE_EXPIRES_IN=90

# Cloudinary (profile photos)
CLOUD_NAME=your-cloud-name
API_KEY=your-api-key
API_SECRET=your-api-secret

# Nodemailer SMTP (used by POST /api/v1/auth/send-email)
# Gmail SMTP is for local/dev only. Use a dedicated provider in production
# (Resend, Postmark, SendGrid, Amazon SES) with a verified domain.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com
SMTP_FROM_NAME=Chatty

# Optional Gmail OAuth2 instead of an App Password
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Supabase Auth → Hooks → Send Email (Standard Webhooks secret)
# Paste the full value from the dashboard, for example: v1,whsec_...
SEND_EMAIL_HOOK_SECRET=v1,whsec_your-hook-secret

# Legacy MongoDB (only for scripts/migrate-mongo-to-supabase.ts)
# DATABASE=mongodb+srv://user:<PASSWORD>@cluster.mongodb.net/chat-app
# DATABASE_PASSWORD=your-mongo-password
# MIGRATION_DEFAULT_PASSWORD=ChangeMe123!
