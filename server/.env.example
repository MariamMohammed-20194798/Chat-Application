# Server
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Legacy MongoDB (only for scripts/migrate-mongo-to-supabase.ts)
# DATABASE=mongodb+srv://user:<PASSWORD>@cluster.mongodb.net/chat-app
# DATABASE_PASSWORD=your-mongo-password
# MIGRATION_DEFAULT_PASSWORD=ChangeMe123!

# JWT cookie duration (days) — Supabase session stored in httpOnly cookie
JWT_COOKIE_EXPIRES_IN=90

# Cloudinary (profile photos)
CLOUD_NAME=your-cloud-name
API_KEY=your-api-key
API_SECRET=your-api-secret
